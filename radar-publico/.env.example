# PostgreSQL (app, worker and migrations)
DATABASE_URL=postgres://radar:radar@localhost:5432/radar_publico

# Public base URL (links in e-mails/webhooks)
APP_BASE_URL=http://localhost:3000

# Private storage for vault uploads (never inside public/)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# First admin (used by `npm run user:create` when flags are omitted)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Source connectors
SOURCE_USER_AGENT=RadarPublico/0.1 (+contato@systagma.com.br)
PNCP_MIN_INTERVAL_MS=1000

# E-mail alerts (optional). Leave SMTP_HOST empty to disable e-mail delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Radar Público <radar@example.com>"

# Webhook signing secret (HMAC-SHA256 header X-Radar-Signature)
WEBHOOK_SECRET=

# AI (V2, optional). Deterministic rules work without it.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
AI_MODEL=
