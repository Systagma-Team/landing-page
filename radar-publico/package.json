{
  "name": "radar-publico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "worker": "tsx --env-file-if-exists=.env src/server/jobs/worker.ts",
    "collect:once": "tsx --env-file-if-exists=.env scripts/collect-once.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
