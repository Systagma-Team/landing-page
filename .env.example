# Production domain, e.g. https://www.example.com.br (no trailing slash). REQUIRED in production:
# canonicals, hreflang, Open Graph, the sitemap and robots.txt are built from it, and while it's empty the whole
# site is served noindex with robots.txt "Disallow: /" (lib/seo.ts `indexable`), so a misconfigured deploy fails safe.
NEXT_PUBLIC_SITE_URL=
# WhatsApp number, digits only with country code (e.g. 5584999999999). Empty hides every WhatsApp CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# 1 logs contact submissions instead of sending them (tests, previews). The mail provider is not implemented yet
# (lib/mailer.ts): without it, real submissions return send_error.
CONTACT_DRY_RUN=
